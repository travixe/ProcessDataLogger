Sub ProcessData()
    Dim ws As Worksheet
    Set ws = ActiveSheet
    
    ' ============================================================
    ' STEP 1: Copy row 7 (B7 to last column) and paste into B11
    ' ============================================================
    Dim lastCol As Long
    lastCol = ws.Cells(4, ws.Columns.Count).End(xlToLeft).Column
    ws.Range(ws.Cells(7, 2), ws.Cells(7, lastCol)).Copy
    ws.Range("B11").PasteSpecial Paste:=xlPasteAll
    Application.CutCopyMode = False
    
    ' ============================================================
    ' STEP 2: Format all cells as General
    ' ============================================================
    Cells.NumberFormat = "General"
    
    ' ============================================================
    ' STEP 3: Find "Comment" row, delete columns that are blank
    ' ============================================================
    Dim commentRow As Long
    Dim cell As Range
    
    For Each cell In ws.Range("A1:A100")
        If cell.Value = "Comment" Then
            commentRow = cell.Row
            Exit For
        End If
    Next cell
    
    If commentRow > 0 Then
        Dim lastColUsed As Long
        lastColUsed = ws.Cells(commentRow, ws.Columns.Count).End(xlToLeft).Column
        
        Dim c As Long
        For c = lastColUsed To 1 Step -1
            If ws.Cells(commentRow, c).Value = "" Then
                ws.Columns(c).Delete
            End If
        Next c
    End If
    
    ' ============================================================
    ' STEP 4: Find "Time" in column A, delete all rows above it
    ' ============================================================
    Dim timeRow As Long
    
    For Each cell In ws.Range("A1:A100")
        If cell.Value = "Time" Then
            timeRow = cell.Row
            Exit For
        End If
    Next cell
    
    If timeRow > 1 Then
        ws.Rows("1:" & timeRow - 1).Delete Shift:=xlShiftUp
    End If
    
    ' ============================================================
    ' STEP 5: Rename last column to "Thermistor Calculated"
    ' ============================================================
    Dim lastDataCol As Long
    lastDataCol = ws.Cells(1, ws.Columns.Count).End(xlToLeft).Column
    ws.Cells(1, lastDataCol).Value = "Thermistor Calculated"
    
    ' ============================================================
    ' STEP 6: Fix Thermistor Calculated values in first 15s
    ' ============================================================
    Dim lastRow As Long
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    
    Dim powerCol As Long, thermCol As Long, timeCol As Long
    Dim searchCol As Long
    
    For searchCol = 1 To ws.UsedRange.Columns.Count
        Select Case ws.Cells(1, searchCol).Value
            Case "Time":                  timeCol = searchCol
            Case "Power":                 powerCol = searchCol
            Case "Thermistor Calculated": thermCol = searchCol
        End Select
    Next searchCol
    
    If timeCol = 0 Or powerCol = 0 Or thermCol = 0 Then
        MsgBox "Could not find one or more column headers. Please check the header names."
        Exit Sub
    End If
    
    Dim i As Long
    For i = 2 To lastRow
        If ws.Cells(i, timeCol).Value <= 15 And ws.Cells(i, powerCol).Value < 10 Then
            ws.Cells(i, thermCol).Value = 0
        End If
    Next i
    
    ' ============================================================
    ' STEP 7: Autofit all column widths
    ' ============================================================
    ws.Cells.EntireColumn.AutoFit
    
    ' ============================================================
    ' STEP 8: Create Scatter with Smooth Lines chart at AE5
    '         with Time as X axis and Power on secondary axis
    ' ============================================================
    Dim chartObj As ChartObject
    Set chartObj = ws.ChartObjects.Add( _
        Left:=ws.Range("AE5").Left, _
        Top:=ws.Range("AE5").Top, _
        Width:=800, _
        Height:=500)
    
    chartObj.Chart.ChartType = xlXYScatterSmooth
    
    Dim srs As Series
    Dim col As Long
    For col = 1 To lastDataCol
        If col <> timeCol Then
            Set srs = chartObj.Chart.SeriesCollection.NewSeries
            srs.Values = ws.Range(ws.Cells(2, col), ws.Cells(lastRow, col))
            srs.XValues = ws.Range(ws.Cells(2, timeCol), ws.Cells(lastRow, timeCol))
            srs.Name = ws.Cells(1, col).Value
            If ws.Cells(1, col).Value = "Power" Then
                srs.AxisGroup = xlSecondary
            End If
        End If
    Next col
    
    chartObj.Chart.HasTitle = True
    chartObj.Chart.ChartTitle.Text = ws.Name
    
    ' ============================================================
    ' STEP 9: Create summary table with MAX and MIN formulas
    ' ============================================================
    Dim summaryStartCol As Long
    summaryStartCol = lastDataCol + 3
    
    ws.Range(ws.Cells(1, 2), ws.Cells(1, lastDataCol)).Copy
    ws.Cells(5, summaryStartCol).PasteSpecial Paste:=xlPasteAll
    Application.CutCopyMode = False
    
    ws.Cells(6, summaryStartCol - 1).Value = "Max"
    ws.Cells(7, summaryStartCol - 1).Value = "Min"
    
    Dim s As Long
    For s = 0 To lastDataCol - 2
        ws.Cells(6, summaryStartCol + s).Formula = "=MAX(" & ws.Cells(61, 2 + s).Address & ":" & ws.Cells(10000, 2 + s).Address & ")"
        ws.Cells(7, summaryStartCol + s).Formula = "=MIN(" & ws.Cells(61, 2 + s).Address & ":" & ws.Cells(10000, 2 + s).Address & ")"
    Next s
    
    ' ============================================================
    ' STEP 10: Freeze panes at cell B2
    ' ============================================================
    ws.Range("B2").Select
    ActiveWindow.FreezePanes = True
    
    MsgBox "Done!"
End Sub
