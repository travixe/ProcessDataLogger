Sub ProcessData()
    Dim ws As Worksheet
    Set ws = ActiveSheet
    
    ' this is basically for the hh7001 config test. we did so many, like so so so many config tests, i was tired of
    ' manually processing each and every single data set so i decided to automate everything with one click instead
    '                                                          -coded and programmed by the one and only travis <3
    
    ' ============================================================
    ' STEP 1: Find "Comment" row, delete columns that are blank in that row
    ' ============================================================
    Dim commentRow As Long
    Dim cell As Range
    
    For Each cell In ws.Range("A1:A100")
        If cell.Value = "Comment" Then
            commentRow = cell.Row
            Exit For
        End If
    Next cell
    
    If commentRow > 0 Then
        Dim lastColDel As Long
        lastColDel = ws.UsedRange.Columns.Count + ws.UsedRange.Column - 1
        
        Dim d As Long
        For d = lastColDel To 2 Step -1
            If ws.Cells(commentRow, d).Value = "" Then
                ws.Columns(d).Delete
            End If
        Next d
    End If
    
    ' ============================================================
    ' STEP 2: Find "Time" row, copy Comment row headers into Time row
    ' ============================================================
    Dim timeRow As Long
    
    For Each cell In ws.Range("A1:A100")
        If cell.Value = "Time" Then
            timeRow = cell.Row
            Exit For
        End If
    Next cell
    
    Dim lastCol As Long
    lastCol = ws.Cells(commentRow, ws.Columns.Count).End(xlToLeft).Column
    ws.Range(ws.Cells(commentRow, 2), ws.Cells(commentRow, lastCol)).Copy
    ws.Range(ws.Cells(timeRow, 2), ws.Cells(timeRow, lastCol)).PasteSpecial Paste:=xlPasteAll
    Application.CutCopyMode = False
    
    ' ============================================================
    ' STEP 3: Format all cells as General
    ' ============================================================
    Cells.NumberFormat = "General"
    
    ' ============================================================
    ' STEP 4: Delete all rows above the Time row
    ' ============================================================
    If timeRow > 1 Then
        ws.Rows("1:" & timeRow - 1).Delete Shift:=xlShiftUp
    End If
    
    ' ============================================================
    ' STEP 5: Rename last column header to "Thermistor Calculated"
    ' ============================================================
    ws.Range("AB1").Value = "Thermistor Calculated"
    
    ' ============================================================
    ' STEP 6: Fix Thermistor Calculated values in first 15s
    ' ============================================================
    Dim lastRow As Long
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    
    Dim powerCol As Long, thermCol As Long, timeCol As Long
    Dim searchCol As Long
    
    For searchCol = 1 To ws.UsedRange.Columns.Count
        Select Case ws.Cells(1, searchCol).Value
            Case "Time":                  timeCol = searchCol
            Case "Power":                 powerCol = searchCol
            Case "Thermistor Calculated": thermCol = searchCol
        End Select
    Next searchCol
    
    If timeCol = 0 Or powerCol = 0 Or thermCol = 0 Then
        MsgBox "Could not find one or more column headers. Please check the header names."
        Exit Sub
    End If
    
    Dim i As Long
    For i = 2 To lastRow
        If ws.Cells(i, timeCol).Value <= 15 And ws.Cells(i, powerCol).Value < 10 Then
            ws.Cells(i, thermCol).Value = 0
        End If
    Next i
    
    ' ============================================================
    ' STEP 7: Autofit all column widths
    ' ============================================================
    ws.Cells.EntireColumn.AutoFit
    
    ' ============================================================
    ' STEP 8: Create chart at AE10
    '         with Time as X axis and Power on secondary axis
    ' ============================================================
    Dim chartObj As ChartObject
    Set chartObj = ws.ChartObjects.Add( _
        Left:=ws.Range("AE10").Left, _
        Top:=ws.Range("AE10").Top, _
        Width:=1600, _
        Height:=1000)
    
    chartObj.Chart.ChartType = xlLine
    
    Dim srs As Series
    Dim col As Long
    For col = 1 To 28
        If col <> timeCol Then
            Set srs = chartObj.Chart.SeriesCollection.NewSeries
            srs.Values = ws.Range(ws.Cells(2, col), ws.Cells(lastRow, col))
            srs.XValues = ws.Range(ws.Cells(2, timeCol), ws.Cells(lastRow, timeCol))
            srs.Name = ws.Cells(1, col).Value
            If ws.Cells(1, col).Value = "Power" Then
                srs.AxisGroup = xlSecondary
            End If
        End If
    Next col
    
    chartObj.Chart.HasTitle = True
    chartObj.Chart.ChartTitle.Text = ws.Name
    
    ' ============================================================
    ' STEP 9: Create summary table at AE5
    ' ============================================================
    ws.Range(ws.Cells(1, 2), ws.Cells(1, 28)).Copy
    ws.Range("AE5").PasteSpecial Paste:=xlPasteAll
    Application.CutCopyMode = False
    
    ws.Range("AD6").Value = "Max"
    ws.Range("AD7").Value = "Min"
    
    Dim c As Long
    For c = 0 To 26
        ws.Cells(6, 31 + c).Formula = "=MAX(" & ws.Cells(61, 2 + c).Address & ":" & ws.Cells(10000, 2 + c).Address & ")"
        ws.Cells(7, 31 + c).Formula = "=MIN(" & ws.Cells(61, 2 + c).Address & ":" & ws.Cells(10000, 2 + c).Address & ")"
    Next c
    
    ' ============================================================
    ' STEP 10: Freeze panes at cell B2
    ' ============================================================
    ws.Range("B2").Select
    ActiveWindow.FreezePanes = True
    
    MsgBox "done!!!"
End Sub
